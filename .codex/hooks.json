{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/guard-bash.py",
            "timeout": 10,
            "statusMessage": "Checking command safety"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/guard-write.py",
            "timeout": 10,
            "statusMessage": "Checking write boundary"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/format-python.sh",
            "timeout": 20,
            "statusMessage": "Formatting"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/session-context.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
