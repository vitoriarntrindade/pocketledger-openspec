# Makefile for Python project with best practices enforcement
# Copy this to your project root as Makefile

.PHONY: help install lint format type-check check fix-all test clean

PYTHON := python3
PIP := $(PYTHON) -m pip
SOURCE_DIR := src app
TEST_DIR := tests

help:
	@echo "Python Project Management Commands"
	@echo ""
	@echo "Setup:"
	@echo "  make install        Install dependencies"
	@echo "  make install-dev    Install dev dependencies"
	@echo ""
	@echo "Code Quality:"
	@echo "  make lint           Run ruff and flake8"
	@echo "  make format         Auto-format code with ruff"
	@echo "  make type-check     Type checking with mypy"
	@echo "  make check          Run all checks (lint + type)"
	@echo "  make fix-all        Auto-fix all fixable issues"
	@echo ""
	@echo "Testing:"
	@echo "  make test           Run tests"
	@echo "  make test-cov       Run tests with coverage"
	@echo ""
	@echo "Maintenance:"
	@echo "  make clean          Remove cache and build files"
	@echo "  make pre-commit     Setup pre-commit hook"

install:
	$(PIP) install -e .

install-dev:
	$(PIP) install -e ".[dev]"

# Linting
lint: lint-ruff lint-flake8
	@echo "✓ Linting complete"

lint-ruff:
	@echo "Running ruff..."
	ruff check $(SOURCE_DIR) $(TEST_DIR)

lint-flake8:
	@echo "Running flake8..."
	flake8 $(SOURCE_DIR) $(TEST_DIR)

# Type checking
type-check:
	@echo "Running mypy..."
	mypy $(SOURCE_DIR) --ignore-missing-imports

# Format code
format:
	@echo "Formatting code with ruff..."
	ruff format $(SOURCE_DIR) $(TEST_DIR)
	ruff check --fix $(SOURCE_DIR) $(TEST_DIR)
	@echo "✓ Code formatted"

# Combined quality checks
check: lint type-check
	@echo "✓ All checks passed"

# Fix all issues
fix-all: format lint-ruff
	@echo "✓ Fixed all auto-fixable issues"

# Testing
test:
	@echo "Running tests..."
	$(PYTHON) -m pytest $(TEST_DIR) -v

test-cov:
	@echo "Running tests with coverage..."
	$(PYTHON) -m pytest $(TEST_DIR) -v --cov=$(SOURCE_DIR) --cov-report=html
	@echo "✓ Coverage report: htmlcov/index.html"

# Cleanup
clean:
	@echo "Cleaning up..."
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
	find . -type d -name .pytest_cache -exec rm -rf {} + 2>/dev/null || true
	find . -type d -name .mypy_cache -exec rm -rf {} + 2>/dev/null || true
	find . -type d -name .ruff_cache -exec rm -rf {} + 2>/dev/null || true
	find . -type d -name .eggs -exec rm -rf {} + 2>/dev/null || true
	find . -type d -name *.egg-info -exec rm -rf {} + 2>/dev/null || true
	find . -type d -name dist -exec rm -rf {} + 2>/dev/null || true
	find . -type d -name build -exec rm -rf {} + 2>/dev/null || true
	find . -type d -name htmlcov -exec rm -rf {} + 2>/dev/null || true
	find . -type f -name .coverage -delete
	find . -type f -name "*.pyc" -delete
	@echo "✓ Cleanup complete"

# Pre-commit setup
pre-commit:
	@echo "Setting up pre-commit hook..."
	$(PIP) install pre-commit
	pre-commit install
	@echo "✓ Pre-commit hook installed"
	@echo "Run 'make pre-commit-run' to test it"

pre-commit-run:
	@echo "Running pre-commit on all files..."
	pre-commit run --all-files

# Development workflow
dev: install-dev
	@echo "✓ Development environment ready"
	@echo "Run 'make check' to verify code quality"
	@echo "Run 'make test' to run tests"
	@echo "Run 'make format' to auto-format code"
