[flake8]
# Line length limit
max-line-length = 78

# Complexity threshold (McCabe)
max-complexity = 10

# Exclude directories
exclude =
    .git
    __pycache__
    .venv
    venv
    build
    dist
    .eggs
    *.egg-info
    .pytest_cache
    .mypy_cache
    .ruff_cache

# Ignore certain error codes
# E203: whitespace before ':'
# W503: line break before binary operator
# W504: line break after binary operator (conflicts with W503)
ignore = E203, W503, W504

# Error codes to ignore per file
per-file-ignores =
    __init__.py:F401,F403
    tests/*:F401,F811,E501
    setup.py:E501

# Docstring style
docstring-convention = google

# Statistics
statistics = True

# Show source code
show-source = True

# Show pep8
show-pep8 = False
