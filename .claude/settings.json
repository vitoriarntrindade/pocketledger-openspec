{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(make *)",
      "Bash(scripts/*)",
      "Bash(.venv/bin/python *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/ruff *)",
      "Bash(.venv/bin/mypy *)",
      "Bash(.venv/bin/pip install -r *)",
      "Bash(uv pip install --python .venv/bin/python *)",
      "Bash(openspec *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git stash *)",
      "Bash(git restore *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(docker compose up -d db)",
      "Bash(docker compose ps *)",
      "Bash(docker compose exec -T db *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(rg *)",
      "Bash(jq *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(gh pr *)",
      "Bash(gh repo *)",
      "Bash(docker compose down *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.pypirc)",
      "Read(~/.claude.json)",
      "Read(//etc/shadow)",
      "Read(./.env)",
      "Edit(//etc/**)",
      "Edit(//usr/**)",
      "Edit(./.env)",
      "Write(./.env)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(gh pr merge *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/guard-bash.py\"",
            "timeout": 10,
            "statusMessage": "Checking command safety"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/guard-write.py\"",
            "timeout": 10,
            "statusMessage": "Checking write boundary"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/scripts/format-python.sh\"",
            "timeout": 20,
            "statusMessage": "Formatting"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/scripts/session-context.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "openspec-propose": "user-invocable-only",
    "openspec-apply-change": "user-invocable-only",
    "openspec-archive-change": "user-invocable-only",
    "openspec-explore": "user-invocable-only",
    "openspec-sync-specs": "user-invocable-only",
    "openspec-update-change": "user-invocable-only"
  }
}
